{
  "manifest_version": 3,
  "name": "Safe UR Link",
  "version": "0.2.0",
  "description": "개발자 관리형 시그니처 배포를 사용하는 악성 URL 탐지 및 브라우저 보호",
  "minimum_chrome_version": "110",
  "permissions": [
    "clipboardRead",
    "storage",
    "tabs",
    "alarms",
    "contextMenus",
    "notifications",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://*.github.io/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "pages/popup/popup.html",
    "default_title": "Safe UR Link"
  },
  "options_page": "pages/options/options.html",
  "icons": {
    "16": "assets/icons/16.png",
    "48": "assets/icons/48.png",
    "128": "assets/icons/128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pages/warning/warning.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
