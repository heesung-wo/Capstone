{
  "manifest_version": 3,
  "name": "Safe UR Link - Capstone Prototype",
  "version": "0.2.0",
  "description": "로컬 시그니처 차단과 PhishTank 상세 검사 프로토타입",
  "minimum_chrome_version": "101",
  "permissions": ["storage", "contextMenus", "tabs", "webNavigation", "alarms", "declarativeNetRequest"],
  "host_permissions": ["http://*/*", "https://*/*", "http://127.0.0.1:3000/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Safe UR Link" },
  "web_accessible_resources": [{ "resources": ["warning.html", "warning.js"], "matches": ["<all_urls>"] }]
}
