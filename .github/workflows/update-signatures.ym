      - name: Collect and build public feed
        working-directory: safe-ur-link
        env:
          ABUSE_CH_AUTH_KEY: ${{ secrets.ABUSE_CH_AUTH_KEY }}
          ...
        run: npm run build:feed
      - uses: actions/configure-pages@v5
      - uses: actions/upload-pages-artifact@v4
        with:
          path: safe-ur-link/public
